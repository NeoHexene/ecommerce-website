# =============================================================================
# .gitignore — Spring Boot (Maven) + Angular Monorepo
# =============================================================================

# =============================================================================
# JAVA / SPRING BOOT / MAVEN
# =============================================================================

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper properties (keep the jar, ignore local overrides)
.mvn/wrapper/maven-wrapper.properties

# Auto-generated by Spring Initializr — no project value
HELP.md

# =============================================================================
# ANGULAR / NODE.JS / NPM
# =============================================================================

# Dependencies
**/node_modules/

# Angular build output
**/dist/
**/tmp/
**/out-tsc/

# Angular cache
**/.angular/cache/

# Angular SSR / pre-rendering
**/dist/browser/
**/dist/server/

# npm / yarn / pnpm
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm
.yarn/

# TypeScript cache
*.tsbuildinfo

# =============================================================================
# IDEs & EDITORS
# =============================================================================

# IntelliJ IDEA / JetBrains
.idea/
*.iws
*.iml
*.ipr

# VS Code — ignore root-level personal settings only
# (Angular subfolder's .vscode/ is auto-generated by Angular CLI and is committed)
/.vscode/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# =============================================================================
# OS / SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

# Environment files
.env
.env.*
!.env.example
!.env.sample

# Application secrets / local overrides
application-local.properties
application-local.yml
application-secrets.properties
application-secrets.yml
src/main/resources/application-local.*
src/main/resources/secrets.*

# =============================================================================
# SENSITIVE / PROJECT-SPECIFIC
# =============================================================================

# Razorpay or other payment CSV exports (contain sensitive data)
*.csv

# Project demo video (large binary, not needed in repo)
*.mov
*.mp4
*.avi

# =============================================================================
# MISC
# =============================================================================

# Spring Boot devtools restart trigger
.reloadtrigger

# JVM crash logs
hs_err_pid*
replay_pid*
